# Copy to .env.phoenix and adjust. Defaults below target a local `phoenix serve`.
# Both are base URLs for the same server. Tracing reads PHOENIX_COLLECTOR_ENDPOINT;
# the API clients read PHOENIX_ENDPOINT (falls back to the collector one if unset).
PHOENIX_ENDPOINT=http://localhost:6006
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=phoenix-agent

# Only if your Phoenix deployment has authentication enabled:
# PHOENIX_API_KEY=
